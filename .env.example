# FaceTrace Chain Configuration

# Search Mode Configuration
# Supported options: 'live' (Google Lens reverse search via SerpAPI) or 'offline' (Local demo corpus simulation)
SEARCH_MODE=live
SEARCH_API_KEY=

# Optional NVIDIA NIM / Multimodal API key
NVIDIA_API_KEY=

# Blockchain Configuration (Local Ganache or Ethereum Testnet)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=

# Face Matching Threshold (0.0 to 1.0)
MATCH_THRESHOLD=0.85
