# FaceTrace Chain Configuration Template

# Reverse Image Search Configuration
# PRIMARY: 'live' (Google Lens reverse visual search via SerpAPI)
# SECONDARY: 'web' (Dynamic Public Media search via Wikimedia API)
SEARCH_MODE=live
SERPAPI_KEY=
SEARCH_API_KEY=

# Optional Image Staging Providers (for Google Lens query staging)
# If left blank, zero-config public temporary staging (Freeimage / TmpFiles) is used automatically.
IMGBB_API_KEY=
FREEIMAGE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Face Recognition Engine Architecture
# Options: 'arcface' (PRIMARY: InsightFace ArcFace 512-d) or 'sface' (FALLBACK: OpenCV SFace 128-d)
FACE_RECOGNITION_ENGINE=arcface

# Multi-Level Match Thresholds (Calibrated for ArcFace: high=0.65, medium=0.45; for SFace: high=0.80, medium=0.60)
FACE_MATCH_HIGH_THRESHOLD=0.65
FACE_MATCH_MEDIUM_THRESHOLD=0.45
TOP_K_CANDIDATES=5

# Optional Multimodal / Generative AI APIs
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Blockchain Configuration (Local Ganache, Anvil, Hardhat, or Auto-Deployed In-Memory Py-EVM)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
